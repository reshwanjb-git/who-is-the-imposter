# Supabase (server-side, geheim — nooit in de client)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase (client-side, mag wel publiek, alleen voor realtime state_version)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Google Gemini (server-side, geheim; gratis quota via aistudio.google.com/apikey).
# Zonder deze key werkt de app gewoon door met de handgemaakte fallback-vragen
# uit lib/fallback-questions.ts.
GEMINI_API_KEY=

# Optioneel: override het Gemini-model (standaard: gemini-3.5-flash-lite).
GEMINI_MODEL=

# Geheime string om de cleanup-cronjob te beveiligen. Vercel zet deze zelf
# automatisch mee als "Authorization: Bearer <CRON_SECRET>" op elke Cron-
# aanroep zodra je een env var met exact deze naam instelt — zelf een lange
# willekeurige waarde verzinnen en hier (en in Vercel) invullen.
CRON_SECRET=
